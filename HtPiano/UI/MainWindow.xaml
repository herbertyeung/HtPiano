<Window x:Class="HtPiano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HtPiano"
        Title="HtPiano" Icon="/Assets/Piano.ico" Width="1060" Height="782" MinWidth="860" MinHeight="700"
        Language="{DynamicResource Lang.XmlLanguage}" WindowStartupLocation="CenterScreen" Background="#101D1A"
        Foreground="#F4F2E8" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="StudioControls.xaml"/>
                <ResourceDictionary Source="StudioFader.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Ink" Color="#101D1A"/>
            <SolidColorBrush x:Key="Surface" Color="#1D302B"/>
            <SolidColorBrush x:Key="Panel" Color="#152521"/>
            <SolidColorBrush x:Key="Line" Color="#385147"/>
            <SolidColorBrush x:Key="Paper" Color="#F4F2E8"/>
            <SolidColorBrush x:Key="Muted" Color="#B3C6B9"/>
            <SolidColorBrush x:Key="Accent" Color="#F1C979"/>
            <SolidColorBrush x:Key="Focus" Color="#007B67"/>
            <Style x:Key="TransportIcon" TargetType="Path">
                <Setter Property="Width" Value="13"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            </Style>
            <Style TargetType="Button" x:Key="Action">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Paper}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="MinHeight" Value="37"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="#29443B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="#375549"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="local:PianoKey">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:PianoKey">
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="0,0,6,6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,4">
                                <Grid>
                                    <Border x:Name="FocusRing" Margin="3" BorderThickness="2" CornerRadius="0,0,4,4"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                      Margin="1,0,1,12"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="#73837C"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource Focus}"/>
                                    <Setter TargetName="FocusRing" Property="BorderThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DiagramNoteButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HitArea" Background="{TemplateBinding Background}" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource Muted}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource Ink}">
    <Grid x:Name="Root" Background="{StaticResource Ink}" Margin="28,19,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.RowSpan="2" Text="HtPiano" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TakeStatus" Text="{DynamicResource Lang.NoRecording}" FontSize="12"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="{Binding ActualWidth, ElementName=TransportButtons}"/>
            <StackPanel x:Name="TransportButtons" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="RecordButton" Style="{StaticResource Action}" Click="RecordTake"
                        AutomationProperties.Name="{DynamicResource Lang.RecordName}" ToolTip="{DynamicResource Lang.RecordTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TransportIcon}" Width="10" Height="10" Fill="#F98C82"
                              Data="M5,0 A5,5 0 1 1 5,10 A5,5 0 1 1 5,0 Z"/>
                        <TextBlock Text="{DynamicResource Lang.Record}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopTakeButton" Style="{StaticResource Action}" Click="StopTake"
                        Margin="6,0" AutomationProperties.Name="{DynamicResource Lang.StopTakeName}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TransportIcon}" Width="10" Height="10" Fill="{StaticResource Paper}"
                              Data="M0,0 H10 V10 H0 Z"/>
                        <TextBlock Text="{DynamicResource Lang.Stop}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PlayTakeButton" Style="{StaticResource Action}" Click="PlayTake"
                        AutomationProperties.Name="{DynamicResource Lang.PlayLastTake}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TransportIcon}" Fill="{StaticResource Paper}" Data="M1,0 L12,7 1,14 Z"/>
                        <TextBlock Text="{DynamicResource Lang.Play}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveTakeButton" Style="{StaticResource Action}" Click="SaveTake" Margin="12,0,6,0"
                        AutomationProperties.Name="{DynamicResource Lang.SaveTake}" ToolTip="{DynamicResource Lang.SaveTakeTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TransportIcon}" Stroke="{StaticResource Paper}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" Data="M1,1 H11 L15,5 V15 H1 Z M4,1 V6 H10 V1 M4,15 V10 H12 V15"/>
                        <TextBlock Text="{DynamicResource Lang.SaveTake}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenTakeButton" Style="{StaticResource Action}" Click="OpenTake"
                        AutomationProperties.Name="{DynamicResource Lang.OpenTake}" ToolTip="{DynamicResource Lang.OpenTakeTip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TransportIcon}" Stroke="{StaticResource Paper}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" Data="M1,13 V2 H6 L8,4 H14 V6 M1,13 L4,6 H16 L13,13 Z"/>
                        <TextBlock Text="{DynamicResource Lang.OpenTake}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="PlayView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="SettingsPanel" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="{StaticResource Panel}" Padding="15,9" Margin="0,0,0,13">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lang.PerformanceSettings}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Paper}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="8,0,12,0" Visibility="{Binding Visibility, ElementName=SettingsBody}" Orientation="Horizontal" VerticalAlignment="Center">
                            <Label Target="{Binding ElementName=LayoutPicker}" Content="{DynamicResource Lang.Layout}"
                                   Padding="0" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <ComboBox Style="{StaticResource StudioPicker}" x:Name="LayoutPicker" Width="240" MinHeight="26" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Lang.Layout}" AutomationProperties.AutomationId="LayoutPicker">
                                <ComboBoxItem Content="{DynamicResource Lang.MultiRowLayout}"/>
                                <ComboBoxItem Content="{DynamicResource Lang.ClassicLayout}"/>
                            </ComboBox>
                            <Label Target="{Binding ElementName=LanguagePicker}" Content="{DynamicResource Lang.LanguageLabel}"
                                   Padding="0" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <ComboBox Style="{StaticResource StudioPicker}" x:Name="LanguagePicker" Width="100" MinHeight="26" VerticalContentAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Lang.LanguageName}" AutomationProperties.AutomationId="LanguagePicker"
                                      DisplayMemberPath="Name" SelectionChanged="OnLanguageSelected"/>
                        </StackPanel>
                        <Button x:Name="SettingsButton" Grid.Column="2" Click="ToggleSettings"
                                Style="{StaticResource Action}" Width="32" MinHeight="28" Padding="0"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTip="{DynamicResource Lang.HideSettings}"
                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                            <Path x:Name="SettingsChevron" Data="M 1,1 L 6,6 L 11,1" Stroke="{StaticResource Paper}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"/>
                        </Button>
                    </Grid>
                    <Grid x:Name="SettingsBody" Margin="0,9,0,0">
                        <Grid.Resources>
                            <Style x:Key="SectionName" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                            <Style x:Key="SettingLabel" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.08*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.ColumnSpan="5" Height="1" Background="{StaticResource Line}" Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="1" Background="{StaticResource Line}" Margin="14,1"/>
                        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="3" Width="1" Background="{StaticResource Line}" Margin="14,1"/>

                        <TextBlock Grid.Row="1" Text="{DynamicResource Lang.SettingsVoices}" Style="{StaticResource SectionName}"/>
                        <Grid Grid.Row="2" Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Lang.SettingsMainKeys}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="MainInstrument" Grid.Column="1" Style="{StaticResource StudioPicker}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Lang.MainInstrumentName}"/>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Lang.SettingsRightKeys}" Style="{StaticResource SettingLabel}"/>
                            <ComboBox x:Name="RightInstrument" Grid.Row="1" Grid.Column="1" Style="{StaticResource StudioPicker}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Lang.RightInstrumentName}" ToolTip="{DynamicResource Lang.RightInstrumentTip}"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Lang.SettingsTouch}" Style="{StaticResource SectionName}"/>
                        <DockPanel Grid.Row="2" Grid.Column="2" Height="32" LastChildFill="False">
                            <TextBlock Text="{DynamicResource Lang.Octave}" Style="{StaticResource SettingLabel}"
                                       ToolTip="{DynamicResource Lang.OctaveTip}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OctaveDown" Content="−" Style="{StaticResource Action}" Width="28" MinHeight="26" Padding="0"
                                        Click="LowerOctave" AutomationProperties.Name="{DynamicResource Lang.OctaveDownName}"/>
                                <TextBlock x:Name="OctaveValue" Width="29" VerticalAlignment="Center" TextAlignment="Center"
                                           FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="OctaveUp" Content="+" Style="{StaticResource Action}" Width="28" MinHeight="26" Padding="0"
                                        Click="RaiseOctave" AutomationProperties.Name="{DynamicResource Lang.OctaveUpName}"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Row="3" Grid.Column="2" Height="34" LastChildFill="False">
                            <TextBlock x:Name="PedalStatus" Style="{StaticResource SettingLabel}" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="SustainButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Style="{StaticResource Action}" MinHeight="26" MinWidth="85" Padding="8,2"
                                    Click="ToggleSustainMode" ToolTip="{DynamicResource Lang.Sustain}"/>
                        </DockPanel>

                        <TextBlock x:Name="MixHeading" Grid.Row="1" Grid.Column="4" Style="{StaticResource SectionName}" Text="{DynamicResource Lang.SettingsMix}"/>
                        <DockPanel Grid.Row="2" Grid.Column="4" MaxWidth="280" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=MixHeading}">
                            <TextBlock Text="{DynamicResource Lang.SettingsVolume}" Style="{StaticResource SettingLabel}"/>
                            <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="42" VerticalAlignment="Center" TextAlignment="Right"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource StudioFader}" MaxWidth="182" Minimum="0" Maximum="100"
                                    Value="80" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    AutomationProperties.Name="{DynamicResource Lang.VolumeName}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="3" Grid.Column="4" MaxWidth="280" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=MixHeading}">
                            <Button x:Name="MetronomeToggle" Content="{DynamicResource Lang.Start}" DockPanel.Dock="Left" Style="{StaticResource Action}"
                                    VerticalAlignment="Center" MinHeight="26" Padding="8,2" Margin="0,0,8,0"
                                    Click="ToggleMetronome" AutomationProperties.Name="{DynamicResource Lang.StartMetronome}"/>
                            <TextBlock x:Name="TempoValue" Text="{Binding Value, ElementName=TempoSlider}" DockPanel.Dock="Right" Width="63" TextAlignment="Right" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Slider x:Name="TempoSlider" Style="{StaticResource StudioFader}" Minimum="40" Maximum="240" Value="120"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                    AutomationProperties.Name="{DynamicResource Lang.TempoName}"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="1">
                <Border x:Name="ComputerPanel" DockPanel.Dock="Top" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                        Padding="12,8,12,9" Margin="0,0,0,12">
                    <local:ComputerKeyboard x:Name="ComputerKeys" />
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="12" Padding="14,9,14,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="1,0,1,9">
                            <TextBlock x:Name="RangeLabel" Text="C4 – C5" DockPanel.Dock="Right"
                                       FontSize="12" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{DynamicResource Lang.PianoKeyboard}" DockPanel.Dock="Left" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="ActiveNotes" Text=" " FontSize="12" Foreground="{StaticResource Paper}"
                                       Margin="12,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="#0D1916" CornerRadius="7" Padding="5,5,5,6">
                            <local:PianoBoard x:Name="Board" ClipToBounds="True" AutomationProperties.Name="{DynamicResource Lang.PianoKeyboardName}"/>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="NotesStatus" DockPanel.Dock="Right" Text="{DynamicResource Lang.NoActiveNotes}"
                       Style="{StaticResource Caption}" Margin="13,1,0,0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="Footer" Text="{DynamicResource Lang.PlayHint}"
                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
